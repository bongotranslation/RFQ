# === Project settings ===
PROJECT_ID=upbeat-legacy-390709
PROJECT_NUMBER=390709   # ← это твой номер проекта

# === Default region/zone ===
REGION=europe-west3
ZONE=europe-west3-b

# === Buckets (GCS) ===
SOURCE_BUCKET=${PROJECT_ID}-source
RESULTS_BUCKET=${PROJECT_ID}-results
TMP_BUCKET=${PROJECT_ID}-tmp

# === OCR / Analyzer tuning ===
ENABLE_OCR=1
OCR_LANGS=ru,en
OCR_DPI=150
OCR_MAX_SIDE_PX=2500
OCR_JPEG_QUALITY=80
MIN_IMG_AREA_FRAC=0.002
LARGE_IMG_AREA_FRAC=0.5
NEEDS_OCR_WORDS_THR=5
